# Copia este ficheiro para ".env" e preenche os valores.
# NUNCA partilhes o teu .env real (com passwords) publicamente ou no GitHub.

PORT=3000

# Frase secreta usada para assinar os tokens de login. Muda isto para algo longo e aleatório.
JWT_SECRET=muda-isto-para-um-segredo-longo-e-aleatorio

# Morada do site (usada para os links dentro dos emails de recuperação de password)
FRONTEND_URL=http://localhost:5500

# --- Conta da Maria Bonita (administradora) ---
# Define estes dois valores para a conta dela ser criada automaticamente
# quando o servidor arranca. Ela entra no site normalmente com este email
# e password, e vê uma área extra para gerir todas as marcações.
ADMIN_EMAIL=maria@mariabonita.pt
ADMIN_PASSWORD=muda-esta-password

# --- Envio de email a sério (opcional) ---
# Se deixares isto vazio, o servidor "finge" que envia o email e escreve o conteúdo
# nos logs, para poderes testar sem teres de configurar nada.
# Para email a sério, a forma mais simples é criar uma conta gratuita no Brevo
# (brevo.com) ou usar uma "App Password" do Gmail, e preencher aqui:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ola@mariabonita.pt
